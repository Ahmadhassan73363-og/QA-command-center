# Required: every /api call needs "Authorization: Bearer <ADMIN_TOKEN>".
ADMIN_TOKEN=change-me-to-a-long-random-string

# Alert channels used by the "default" policy. Leave blank to disable a channel.
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Email alerts (Resend) — sent only when a site is confirmed down (see src/alerts/notify.ts).
RESEND_API_KEY=
ALERT_EMAIL_FROM=QA Command Center <onboarding@resend.dev>
# Comma-separated recipient(s) for down alerts — sending is skipped while empty.
ALERT_EMAIL_TO=

# Serve the status page at / without a token (internal networks only).
STATUS_PAGE_PUBLIC=false

# How the monitor identifies itself. Allowlist this in your CDN / bot protection.
MONITOR_USER_AGENT=QACommandCenter/2.0 (+https://example.com/monitor)
# Optional shared secret sent as X-Monitor-Token on every request.
MONITOR_TOKEN=

# Tuning
TIER1_EVERY_MS=600000
WORKER_CONCURRENCY=50
PROBE_REGION=local

# Local dev only: path to a Chrome/Chromium/Edge executable, used to capture site
# screenshots (GET /api/sites/:id/screenshot). Auto-detected on common install paths
# if left blank. Not needed on Vercel — @sparticuz/chromium supplies its own binary there.
CHROME_PATH=
